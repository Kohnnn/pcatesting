# SentimentAlpha Vietnam - Environment Configuration

# Database Configuration
# Path to SQLite database file (relative to project root)
DATABASE_PATH=sentimentalpha.db

# Data Directories
# Directory containing raw CSV files from FiinPro/Bloomberg
DATA_SOURCE_DIR=xlsx
# Directory for processed Parquet files
DATA_OUTPUT_DIR=data

# API Configuration
# Backend API URL (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Server Configuration
# Host and port for FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# Development Settings
# Set to 'development' or 'production'
ENVIRONMENT=development

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
